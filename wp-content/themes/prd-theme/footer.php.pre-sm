<?php
$legal_links = array(
	'privacy-policy' => 'Privacy Policy',
	'cookie-policy'  => 'Cookie Policy',
	'terms'          => 'Terms',
	'disclaimer'     => 'Disclaimer',
);
foreach ( $legal_links as $legal_slug => $legal_label ) {
	$legal_page = get_page_by_path( $legal_slug );
	if ( $legal_page && 'publish' === $legal_page->post_status ) {
		printf( '<li><a href="%s">%s</a></li>', esc_url( home_url( '/' . $legal_slug . '/' ) ), esc_html( $legal_label ) );
	}
}
?>
