<?php
if ( ! defined( 'ABSPATH' ) ) exit;

define( 'PRD_VERSION', '2.0.0' );
define( 'PRD_DIR', get_template_directory() );
define( 'PRD_URI', get_template_directory_uri() );

function prd_setup() {
    add_theme_support( 'title-tag' );
    add_theme_support( 'post-thumbnails' );
    add_theme_support( 'html5', ['search-form','comment-form','comment-list','gallery','caption','style','script'] );
    add_theme_support( 'custom-logo', ['height'=>40,'width'=>200,'flex-height'=>true,'flex-width'=>true] );
    register_nav_menus([
        'primary' => __( 'Primary Menu', 'prd-theme' ),
        'footer'  => __( 'Footer Menu', 'prd-theme' ),
    ]);
}
add_action( 'after_setup_theme', 'prd_setup' );

function prd_enqueue() {
    wp_enqueue_style( 'prd-fonts', 'https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap', [], null );
    wp_enqueue_style( 'prd-catalog', PRD_URI.'/assets/css/catalog.css', [], PRD_VERSION );
    wp_enqueue_style( 'prd-tokens', PRD_URI . '/assets/css/tokens.css', [], PRD_VERSION );
    wp_enqueue_style( 'prd-components', PRD_URI . '/assets/css/components.css', ['prd-tokens'], PRD_VERSION );
    wp_enqueue_script( 'prd-navigation', PRD_URI . '/assets/js/navigation.js', [], PRD_VERSION, true );
    wp_enqueue_script( 'prd-main', PRD_URI . '/assets/js/main.js', [], PRD_VERSION, true );
}
add_action( 'wp_enqueue_scripts', 'prd_enqueue' );

require_once PRD_DIR . '/inc/template-tags.php';
require_once PRD_DIR . '/inc/cpt-psychic.php';
require_once PRD_DIR . '/inc/reviews.php';

function prd_clean_psychic_content( $content ) {
    if ( get_post_type() !== 'psychic' ) return $content;
    $content = preg_replace( '/window\.\w+\s*=\s*["{].*?["}];?\s*/s', '', $content );
    $content = preg_replace( '/<script[^>]*>.*?<\/script>/si', '', $content );
    return trim( $content );
}
add_filter( 'the_content', 'prd_clean_psychic_content', 5 );
/* homeblocks-slot */ require_once get_template_directory() . '/inc/homeblocks.php';

/* === BEGIN catalog-filter module (prd) — wp-net-control rollout === */
require_once get_template_directory() . '/inc/catalog-index.php';

function prd_catalog_filter_enqueue() {
    if ( is_post_type_archive( 'psychic' ) || is_tax( 'psychic_specialty' ) || is_tax( 'psychic_skill' ) ) {
        $dir = get_template_directory();
        $uri = get_template_directory_uri();
        $css = $dir . '/assets/css/catalog-filter.css';
        $js  = $dir . '/assets/js/catalog-filter.js';
        wp_enqueue_style( 'prd-catalog-filter', $uri . '/assets/css/catalog-filter.css', array(), file_exists( $css ) ? filemtime( $css ) : '1.0.0' );
        wp_enqueue_script( 'prd-catalog-filter', $uri . '/assets/js/catalog-filter.js', array(), file_exists( $js ) ? filemtime( $js ) : '1.0.0', true );
    }
}
add_action( 'wp_enqueue_scripts', 'prd_catalog_filter_enqueue', 20 );
/* === END catalog-filter module (prd) — wp-net-control rollout === */
